{
  "name": "wyrm",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build:contracts": "bash contracts/build.sh",
    "test:contracts": "cd contracts && cargo test --workspace",
    "test:wsl": "wsl -d Ubuntu -e bash -c \"bash <(tr -d '\\r' < contracts/wsl-test.sh) \\\"$@\\\"\" wsl-test",
    "gym": "node gym/gym.mjs",
    "keeper": "node keeper/keeper.mjs",
    "verify": "node verify/verify.mjs",
    "audit-dragon": "node verify/audit-dragon.mjs",
    "test": "node --test \"gym/*.test.mjs\" \"keeper/*.test.mjs\" \"verify/*.test.mjs\" \"lair/*.test.mjs\""
  }
}
